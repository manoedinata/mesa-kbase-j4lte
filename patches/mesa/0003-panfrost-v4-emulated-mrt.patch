+#if PAN_ARCH == 4
+/* Midgard v4 emulated MRT: fragment varying descriptors of a per-RT variant.
+ * The vertex shader runs once for all passes, so the varying layout is the
+ * one linked against the full fragment shader; the variant may read only a
+ * subset of it.
+ */
+static mali_ptr
+panfrost_v4_mrt_emit_fs_varyings(struct panfrost_batch *batch,
+                                 struct panfrost_compiled_shader *vs,
+                                 struct panfrost_compiled_shader *full,
+                                 struct panfrost_compiled_shader *fs,
+                                 uint16_t point_coord_mask)
+{
+   struct panfrost_device *dev = pan_device(batch->ctx->base.screen);
+   unsigned consumer_count = fs->info.varyings.input_count;
+
+   if (!consumer_count)
+      return 0;
+
+   signed offsets[PAN_MAX_VARYINGS];
+   unsigned present =
+      pan_varying_present(dev, &vs->info, &full->info, point_coord_mask);
+   pan_assign_varyings(dev, &vs->info, &full->info, offsets);
+
+   struct panfrost_ptr T =
+      pan_pool_alloc_desc_array(&batch->pool.base, consumer_count, ATTRIBUTE);
+   struct mali_attribute_packed *descs = T.cpu;
+
+   for (unsigned i = 0; i < consumer_count; ++i) {
+      signed j = pan_find_vary(vs->info.varyings.output,
+                               vs->info.varyings.output_count,
+                               fs->info.varyings.input[i].location);
+
+      panfrost_emit_varying(dev, descs + i, fs->info.varyings.input[i],
+                            fs->info.varyings.input[i].format, present,
+                            point_coord_mask, (j >= 0) ? offsets[j] : -1,
+                            PAN_VARY_FRAGCOORD);
+   }
+
+   return T.gpu;
+}
+
+/* Midgard v4 emulated MRT: emit the fragment-stage state of every render
+ * target pass for the current draw (RSD with RT i's blend, uniforms and
+ * varyings of fragment shader variant i). The draw descriptor copies built in
+ * pan_jm.c point at these.
+ */
+static void
+panfrost_v4_mrt_emit_passes(struct panfrost_batch *batch, bool points)
+{
+   struct panfrost_context *ctx = batch->ctx;
+   unsigned n = panfrost_batch_v4_mrt_passes(batch, PAN_ARCH);
+
+   if (!n)
+      return;
+
+   struct panfrost_compiled_shader *vars[PIPE_MAX_COLOR_BUFS];
+   panfrost_get_fs_variants_for_rts(ctx, n, vars);
+
+   struct panfrost_compiled_shader *vs = ctx->prog[PIPE_SHADER_VERTEX];
+   struct panfrost_compiled_shader *full = ctx->prog[PIPE_SHADER_FRAGMENT];
+   uint16_t point_coord_mask =
+      points ? ctx->rasterizer->base.sprite_coord_enable : 0;
+   struct panfrost_bo *blend_bo = NULL;
+   unsigned blend_offset = 0;
+
+   for (unsigned i = 0; i < n; ++i) {
+      memset(&batch->v4_mrt[i], 0, sizeof(batch->v4_mrt[i]));
+
+      /* No pass for a missing colour buffer: its draw descriptor copy is
+       * never selected by any FBD. */
+      if (!batch->key.cbufs[i])
+         continue;
+
+      struct panfrost_compiled_shader *fs = vars[i];
+
+      panfrost_batch_add_bo(batch, fs->bin.bo, PIPE_SHADER_FRAGMENT);
+      batch->stack_size = MAX2(batch->stack_size, fs->info.tls_size);
+
+      mali_ptr blend_shaders[PIPE_MAX_COLOR_BUFS] = {0};
+      blend_shaders[i] =
+         panfrost_get_blend_as_rt0(batch, i, &blend_bo, &blend_offset);
+
+      struct panfrost_ptr rsd =
+         pan_pool_alloc_desc(&batch->pool.base, RENDERER_STATE);
+      panfrost_emit_frag_shader(ctx, fs, i,
+                                (struct mali_renderer_state_packed *)rsd.cpu,
+                                blend_shaders);
+      batch->v4_mrt[i].rsd = rsd.gpu;
+
+      /* Uniforms and sysvals are laid out per variant */
+      unsigned nr_ubo, nr_push;
+      ctx->prog[PIPE_SHADER_FRAGMENT] = fs;
+      batch->v4_mrt[i].uniform_buffers = panfrost_emit_const_buf(
+         batch, PIPE_SHADER_FRAGMENT, &nr_ubo, &batch->v4_mrt[i].push_uniforms,
+         &nr_push);
+      ctx->prog[PIPE_SHADER_FRAGMENT] = full;
+
+      batch->v4_mrt[i].varyings =
+         panfrost_v4_mrt_emit_fs_varyings(batch, vs, full, fs, point_coord_mask);
+   }
+}
+#endif
