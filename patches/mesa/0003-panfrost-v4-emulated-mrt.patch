+/* Midgard v4 emulated MRT: get the fragment shader variant of every render
+ * target pass (variant i writes only RT i, as RT0). Creating variants can
+ * reallocate the variant array, so ctx->prog[FRAGMENT] is re-pointed and all
+ * results are resolved only after every variant exists.
+ */
+void
+panfrost_get_fs_variants_for_rts(struct panfrost_context *ctx, unsigned nr_rts,
+                                 struct panfrost_compiled_shader **out)
+{
+   struct panfrost_uncompiled_shader *uncompiled =
+      ctx->uncompiled[PIPE_SHADER_FRAGMENT];
+   int idx[PIPE_MAX_COLOR_BUFS];
+
+   assert(nr_rts <= PIPE_MAX_COLOR_BUFS);
+   simple_mtx_lock(&uncompiled->lock);
+
+   struct panfrost_compiled_shader *base = util_dynarray_begin(&uncompiled->variants);
+   ptrdiff_t cur = ctx->prog[PIPE_SHADER_FRAGMENT]
+                      ? ctx->prog[PIPE_SHADER_FRAGMENT] - base
+                      : -1;
+
+   for (unsigned rt = 0; rt < nr_rts; ++rt) {
+      struct panfrost_shader_key key = {0};
+      panfrost_build_key(ctx, &key, uncompiled);
+
+      enum pipe_format fmt = key.fs.rt_formats[rt];
+      memset(key.fs.rt_formats, 0, sizeof(key.fs.rt_formats));
+      key.fs.rt_formats[0] = fmt;
+      key.fs.v4_mrt_rt = rt + 1;
+
+      idx[rt] = -1;
+      unsigned n = 0;
+      util_dynarray_foreach(&uncompiled->variants,
+                            struct panfrost_compiled_shader, so) {
+         if (memcmp(&key, &so->key, sizeof(key)) == 0) {
+            idx[rt] = n;
+            break;
+         }
+         n++;
+      }
+
+      if (idx[rt] < 0) {
+         panfrost_new_variant_locked(ctx, uncompiled, &key);
+         idx[rt] = util_dynarray_num_elements(&uncompiled->variants,
+                                              struct panfrost_compiled_shader) - 1;
+      }
+   }
+
+   base = util_dynarray_begin(&uncompiled->variants);
+   if (cur >= 0)
+      ctx->prog[PIPE_SHADER_FRAGMENT] = base + cur;
+   for (unsigned rt = 0; rt < nr_rts; ++rt)
+      out[rt] = base + idx[rt];
+
+   simple_mtx_unlock(&uncompiled->lock);
+}
