+
+/* Midgard v4 emulated MRT: keep only the colour output of render target `rt`
+ * and move it to RT0 (DATA0). Stores to other render targets are removed and
+ * framebuffer fetches from them read zero. Depth, stencil and sample mask
+ * outputs are untouched.
+ */
+static bool
+select_rt_pass(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   unsigned rt = *(unsigned *)data;
+   bool store = intr->intrinsic == nir_intrinsic_store_output;
+   bool load = intr->intrinsic == nir_intrinsic_load_output;
+
+   if (!store && !load)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   if (sem.location < FRAG_RESULT_DATA0)
+      return false;
+
+   if (sem.location - FRAG_RESULT_DATA0 == rt) {
+      sem.location = FRAG_RESULT_DATA0;
+      nir_intrinsic_set_io_semantics(intr, sem);
+      return true;
+   }
+
+   if (store) {
+      nir_instr_remove(&intr->instr);
+   } else {
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components,
+                                               intr->def.bit_size));
+   }
+   return true;
+}
+
+bool
+panfrost_nir_select_rt(nir_shader *s, unsigned rt)
+{
+   const uint64_t data_mask = ~BITFIELD64_MASK(FRAG_RESULT_DATA0);
+   bool progress = nir_shader_intrinsics_pass(
+      s, select_rt_pass, nir_metadata_control_flow, &rt);
+
+   uint64_t written = s->info.outputs_written;
+   uint64_t read = s->info.outputs_read;
+   s->info.outputs_written &= ~data_mask;
+   s->info.outputs_read &= ~data_mask;
+   if (written & BITFIELD64_BIT(FRAG_RESULT_DATA0 + rt))
+      s->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_DATA0);
+   if (read & BITFIELD64_BIT(FRAG_RESULT_DATA0 + rt))
+      s->info.outputs_read |= BITFIELD64_BIT(FRAG_RESULT_DATA0);
+
+   return progress;
+}
