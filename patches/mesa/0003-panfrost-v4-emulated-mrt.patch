+#if PAN_ARCH == 4
+/* Midgard v4 emulated MRT: one SFBD per colour buffer. Pass i renders RT i
+ * as its only target and selects draw descriptor copy i with the DCD offset.
+ * Every pass starts from the same Z/S state (clear or preload) and runs the
+ * same primitives, so all passes compute the same Z/S result; only the last
+ * pass writes it back. The first pass uses the batch FBD, which is also the
+ * one the draws point at for the tiler context and TLS.
+ */
+static void
+jm_emit_v4_mrt_fbds(struct panfrost_batch *batch, struct pan_fb_info *fb,
+                    struct pan_tls_info *tls, unsigned passes)
+{
+   int last = -1;
+
+   for (unsigned i = 0; i < passes; ++i) {
+      if (fb->rts[i].view)
+         last = i;
+   }
+
+   batch->v4_mrt_nr_fbd = 0;
+
+   for (unsigned i = 0; i < passes; ++i) {
+      if (!fb->rts[i].view && !(last < 0 && i == 0))
+         continue;
+
+      struct pan_fb_info pass = *fb;
+      pass.rt_count = fb->rts[i].view ? 1 : 0;
+      pass.rts[0] = fb->rts[i];
+      for (unsigned j = 1; j < ARRAY_SIZE(pass.rts); j++)
+         pass.rts[j] = (struct pan_fb_color_attachment){0};
+      pass.sfbd_dcd_offset = PAN_V4_MRT_DCD_STRIDE * i;
+
+      if ((int)i != last && last >= 0) {
+         pass.zs.discard.z = true;
+         pass.zs.discard.s = true;
+      }
+
+      struct panfrost_ptr fbd =
+         batch->v4_mrt_nr_fbd ? pan_pool_alloc_desc(&batch->pool.base, FRAMEBUFFER)
+                              : batch->framebuffer;
